<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="house">

    <gravity>0 0 -9.8</gravity>
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <!-- NOTE: Sensors plugin is NOT here — it is loaded by the robot URDF (plugins.urdf.xacro).
         Having it in BOTH the world AND the model causes a segfault in Gazebo Harmonic. -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walled Room 10x10m -->
    <model name="room_walls">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      
      <!-- North Wall -->
      <link name="wall_north">
        <pose>0 5 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>

      <!-- South Wall -->
      <link name="wall_south">
        <pose>0 -5 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>

      <!-- East Wall -->
      <link name="wall_east">
        <pose>5 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>

      <!-- West Wall -->
      <link name="wall_west">
        <pose>-5 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 1</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      
      <!-- Inner obstacle 1 -->
      <link name="inner_box_1">
        <pose>2 2 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient></material>
        </visual>
      </link>
      
      <!-- Inner obstacle 2 -->
      <link name="inner_box_2">
        <pose>-2 -1 0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2 0.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 0.5 1</size></box></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient></material>
        </visual>
      </link>

    </model>

  </world>
</sdf>
